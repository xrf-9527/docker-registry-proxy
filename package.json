		"smoke": "node scripts/smoke.mjs"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.4.10",
		"prettier": "3.9.10",
		"vitest": "5.0.5",
		"wrangler": "4.155.0"
	},
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	}
}
